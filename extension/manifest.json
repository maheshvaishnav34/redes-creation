{
  "manifest_version": 3,
  "name": "Redes Creation — Google Review Auto-Filler",
  "version": "1.1.0",
  "description": "Automatically connects Redes Creation review drafts directly to Google Review dialogs and auto-fills review text.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content-redes.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://search.google.com/*"
      ],
      "js": ["content-google.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Redes Creation Review Connector",
    "default_popup": "popup.html"
  }
}
