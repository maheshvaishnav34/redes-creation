# ============================================================
# Multi-Tenant Hotel Review SaaS — Docker & Environment Setup
# ============================================================

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=hotel_review_saas_db

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/hotel_review_saas_db

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Security Secrets (Generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
SESSION_SECRET=replace_with_another_long_random_secret_key
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key_for_refresh_tokens

# Google OAuth 2.0 Credentials (Google Business Profile API)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/google/callback

# Google Places API Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# AI Review Intelligence (Official Groq SDK)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
