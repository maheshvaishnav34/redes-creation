# ============================================================
# Google Review + Local SEO Intelligence System
# Production-Oriented MERN SaaS with PostgreSQL, Prisma ORM, Google OAuth 2.0 and Groq AI
# ============================================================

NODE_ENV=development
PORT=5000

# PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Authentication & Session Security
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_or_random_encryption_key

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 & Google APIs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Groq AI SDK (Official groq-sdk)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key
