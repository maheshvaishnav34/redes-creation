# ============================================================
# Redes Creation SaaS – Server Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# PostgreSQL Database
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=redes_creation

# JWT Secret (change this to a long random string in production!)
JWT_SECRET=your_very_long_super_secret_jwt_key_change_this_in_production

# Frontend URL (used for CORS and QR code links)
# Set this to your deployed frontend domain, e.g. https://app.redescreation.in
CLIENT_URL=https://your-domain.com
