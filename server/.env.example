# ============================================================
# Multi-Tenant Hotel Review SaaS Configuration Template
# ============================================================

# Environment & Server
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Direct connection & pool)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/hotel_review_saas_db
DIRECT_URL=postgresql://postgres:postgres123@localhost:5432/hotel_review_saas_db

# Redis / BullMQ Distributed Background Queue
# (If unset, the application automatically runs in High-Performance In-Process Queue mode)
REDIS_URL=redis://localhost:6379

# Cryptography & Security
# Generate 32-byte hex for AES-256 token encryption at rest: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
SESSION_SECRET=replace_with_another_long_random_secret_key
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key_for_refresh_tokens

# Google OAuth 2.0 (Google Business Profile API)
# Scope required: https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Google Maps Platform (Places API - Separate from Business Profile OAuth)
# Used for Place ID resolution and Maps shortlinks (Max 5 reviews public limit)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google Cloud Pub/Sub (Optional Real-Time Push Subscriptions)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_REVIEWS=projects/your-gcp-project-id/topics/gbp-review-notifications

# AI Sentiment & Reply Intelligence (Groq Cloud SDK)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
